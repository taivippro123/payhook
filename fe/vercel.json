{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://rimmed-improvise-hatchery.ngrok-free.dev/api/$1"
        },
        {
            "source": "/ws",
            "destination": "https://rimmed-improvise-hatchery.ngrok-free.dev/ws"
        },
        { 
            "source": "/((?!sitemap\\.xml|robots\\.txt|favicon\\.ico|.*\\.png|.*\\.svg|.*\\.webmanifest).*)", 
            "destination": "/index.html" 
        }
    ],
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml; charset=utf-8"
                }
            ]
        },
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        }
    ]
}